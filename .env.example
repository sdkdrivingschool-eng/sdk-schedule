# Copy to .env and fill in. Both values are safe in the browser: the
# publishable key only grants what RLS policies allow.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Google Ads "Booking completed" conversion label (the part after AW-16890045753/). Empty = no conversion sent.
VITE_GADS_BOOKING_LABEL=
